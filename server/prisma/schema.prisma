generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  LAND
}

enum TransactionType {
  SALE
  RENT
}

enum Currency {
  EUR
  RON
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  listings     Listing[]
  favorites    Favorite[]
  savedSearches SavedSearch[]

  @@map("users")
}

model Listing {
  id              String          @id @default(cuid())
  ownerId         String
  title           String
  description     String
  propertyType    PropertyType
  transactionType TransactionType
  price           Decimal         @db.Decimal(12, 2)
  currency        Currency        @default(EUR)
  city            String
  county          String
  address         String
  latitude        Decimal         @db.Decimal(9, 6)
  longitude       Decimal         @db.Decimal(9, 6)
  surface         Int
  rooms           Int?
  bathrooms       Int?
  floor           Int?
  yearBuilt       Int?
  status          ListingStatus   @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images          ListingImage[]
  favorites       Favorite[]
  messages        Message[]

  @@index([status])
  @@index([city])
  @@index([county])
  @@index([propertyType])
  @@index([transactionType])
  @@index([price])
  @@index([createdAt])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("favorites")
}

model Message {
  id          String   @id @default(cuid())
  listingId   String
  senderName  String
  senderEmail String
  message     String
  createdAt   DateTime @default(now())
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("messages")
}

model SavedSearch {
  id              String           @id @default(cuid())
  userId          String
  name            String
  city            String?
  county          String?
  propertyType    PropertyType?
  transactionType TransactionType?
  minPrice        Decimal?         @db.Decimal(12, 2)
  maxPrice        Decimal?         @db.Decimal(12, 2)
  rooms           Int?
  sort            String           @default("newest")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}
