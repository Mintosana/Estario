generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  LAND
}

enum TransactionType {
  SALE
  RENT
}

enum Currency {
  EUR
  RON
}

enum FurnishingStatus {
  UNFURNISHED
  PARTIAL
  FURNISHED
}

enum CompartmentalizationType {
  DETACHED
  SEMI_DETACHED
  NON_DETACHED
  CIRCULAR
  OPEN_SPACE
}

enum ParkingType {
  NONE
  PARKING_SPOT
  GARAGE
}

enum HeatingType {
  CENTRAL
  DISTRICT
  ELECTRIC
  GAS
  OTHER
}

enum CentralHeatingType {
  INDIVIDUAL
  BUILDING
  RESIDENTIAL_COMPLEX
}

enum BuildingCondition {
  NEW
  RENOVATED
  GOOD
  NEEDS_RENOVATION
}

enum EnergyClass {
  A
  B
  C
  D
  E
  UNKNOWN
}

enum NotificationType {
  LISTING_APPROVED
  LISTING_REJECTED
  NEW_MESSAGE
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  bio          String?
  promotionCredits Int       @default(0)
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  listings     Listing[]
  favorites    Favorite[]
  savedSearches SavedSearch[]
  buyerConversations Conversation[] @relation("BuyerConversations")
  ownerConversations Conversation[] @relation("OwnerConversations")
  sentMessages Message[] @relation("SentMessages")
  notifications Notification[]
  promotionPurchases PromotionPurchase[]

  @@map("users")
}

model PromotionPurchase {
  id              String    @id @default(cuid())
  stripeSessionId String    @unique
  userId          String
  bundleKey       String
  credits         Int
  amount          Int
  currency        String
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("promotion_purchases")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  targetUrl String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model Listing {
  id              String          @id @default(cuid())
  ownerId         String
  title           String
  description     String
  propertyType    PropertyType
  transactionType TransactionType
  price           Decimal         @db.Decimal(12, 2)
  currency        Currency        @default(EUR)
  city            String
  county          String
  address         String
  latitude        Decimal         @db.Decimal(9, 6)
  longitude       Decimal         @db.Decimal(9, 6)
  surface         Int
  rooms           Int?
  bathrooms       Int?
  floor           Int?
  totalFloors     Int?
  yearBuilt       Int?
  balcony         Boolean?
  hasAirConditioning Boolean?
  hasElevator     Boolean?
  petFriendly     Boolean?
  compartmentalization CompartmentalizationType?
  parking         ParkingType?
  furnished       FurnishingStatus?
  heatingType     HeatingType?
  centralHeatingType CentralHeatingType?
  buildingCondition BuildingCondition?
  energyClass     EnergyClass?
  status          ListingStatus   @default(PENDING)
  rejectionReason String?
  viewCount       Int             @default(0)
  sponsoredAt     DateTime?
  sponsoredUntil  DateTime?
  sponsoredViewBaseline Int?
  sponsoredPreviousViewEstimate Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images          ListingImage[]
  favorites       Favorite[]
  messages        Message[]
  conversations   Conversation[]

  @@index([status])
  @@index([city])
  @@index([county])
  @@index([propertyType])
  @@index([transactionType])
  @@index([compartmentalization])
  @@index([hasAirConditioning])
  @@index([hasElevator])
  @@index([petFriendly])
  @@index([price])
  @@index([sponsoredUntil])
  @@index([createdAt])
  @@map("listings")
}

model PointOfInterest {
  id        String   @id @default(cuid())
  name      String
  category  String
  city      String
  county    String
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([city])
  @@index([county])
  @@index([latitude, longitude])
  @@map("points_of_interest")
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  ownerId   String
  buyerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner     User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([listingId, buyerId])
  @@index([ownerId])
  @@index([buyerId])
  @@index([listingId])
  @@index([updatedAt])
  @@map("conversations")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("favorites")
}

model Message {
  id          String   @id @default(cuid())
  listingId   String
  conversationId String?
  senderId    String?
  senderName  String
  senderEmail String
  message     String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender      User?    @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([conversationId])
  @@index([senderId])
  @@index([readAt])
  @@map("messages")
}

model SavedSearch {
  id              String           @id @default(cuid())
  userId          String
  name            String
  city            String?
  county          String?
  propertyType    PropertyType?
  transactionType TransactionType?
  currency        Currency?
  minPrice        Decimal?         @db.Decimal(12, 2)
  maxPrice        Decimal?         @db.Decimal(12, 2)
  rooms           Int?
  balcony         Boolean?
  hasAirConditioning Boolean?
  hasElevator     Boolean?
  petFriendly     Boolean?
  compartmentalization CompartmentalizationType?
  parking         ParkingType?
  furnished       FurnishingStatus?
  heatingType      HeatingType?
  centralHeatingType CentralHeatingType?
  sort            String           @default("relevance")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}
